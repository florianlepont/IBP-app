PORT=3000
NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=ibp

# local | minio
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_BUCKET=ibp-media
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio123
ATTACHMENTS_UPLOAD_DIR=/tmp/ibp-uploads

# Cadastre provider
# synthetic | ign
CADASTRE_PROVIDER=synthetic
CADASTRE_PROVIDER_ALLOW_FALLBACK=true
CADASTRE_PROVIDER_TIMEOUT_MS=2500
# IGN reverse geocoding endpoint (parcel index)
CADASTRE_IGN_REVERSE_URL=https://data.geopf.fr/geocodage/reverse
# IGN API Carto parcel geometry endpoint
CADASTRE_IGN_APICARTO_PARCEL_URL=https://apicarto.ign.fr/api/cadastre/parcelle

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Development helper: expose email confirmation token in API response.
AUTH_DEV_EXPOSE_EMAIL_TOKEN=true
# Development helper: allow implicit account creation on first login email.
# Defaults to true outside production if omitted.
AUTH_LOGIN_OR_CREATE_ENABLED=true

# SMTP (email confirmation)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ibp.local
# Optional URL template used in email body (ex: ibp://confirm-email?token={token})
EMAIL_CHANGE_CONFIRM_URL_TEMPLATE=

# Debug reset endpoints (/v1/debug/reset-ibp-data and /v1/debug/reset-user-data)
DEBUG_DATA_RESET_ENABLED=true

# Auth0
# AUTH0_DOMAIN: tenant domain used for management API and back-office calls.
# AUTH0_PUBLIC_DOMAIN: optional public/custom domain used by the mobile app for login.
AUTH0_DOMAIN=
AUTH0_PUBLIC_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_APP_CLIENT_ID=
