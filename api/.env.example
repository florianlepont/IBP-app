PORT=3000
NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=ibp

# local | minio
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_BUCKET=ibp-surveys
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio123
ATTACHMENTS_UPLOAD_DIR=/tmp/ibp-uploads

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Development helper: expose email confirmation token in API response.
AUTH_DEV_EXPOSE_EMAIL_TOKEN=true

# SMTP (email confirmation)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ibp.local
# Optional URL template used in email body (ex: ibp://confirm-email?token={token})
EMAIL_CHANGE_CONFIRM_URL_TEMPLATE=
