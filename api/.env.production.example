PORT=3000
NODE_ENV=production

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Optional pool and timeout settings (defaults shown)
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# S3-compatible object storage (OVH Object Storage)
OBJECT_STORAGE_MODE=minio
OBJECT_STORAGE_BUCKET=ibp-media
OBJECT_STORAGE_ENDPOINT=https://s3.<region>.perf.cloud.ovh.net
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME

# Cadastre IGN (production)
CADASTRE_PROVIDER=ign
CADASTRE_PROVIDER_ALLOW_FALLBACK=false
CADASTRE_PROVIDER_TIMEOUT_MS=2500
CADASTRE_IGN_REVERSE_URL=https://data.geopf.fr/geocodage/reverse
CADASTRE_IGN_APICARTO_PARCEL_URL=https://apicarto.ign.fr/api/cadastre/parcelle

# Disable dev helpers (must stay false in production)
DEBUG_DATA_RESET_ENABLED=false
AUTH0_DOMAIN=CHANGE_ME.eu.auth0.com
AUTH0_AUDIENCE=https://api.ibp-app
AUTH0_APP_CLIENT_ID=CHANGE_ME_AUTH0_APP_CLIENT_ID
AUTH0_MGMT_CLIENT_ID=CHANGE_ME_AUTH0_MGMT_CLIENT_ID
AUTH0_MGMT_CLIENT_SECRET=CHANGE_ME_AUTH0_MGMT_CLIENT_SECRET

# none = aucune origine navigateur ; l'app mobile n'utilise pas CORS ;
# vide ou absent = démarrage refusé en production.
# For a browser client, a comma-separated list of origins instead, e.g.
# https://app.example.org (scheme and host only, no path or trailing slash).
CORS_ORIGIN=none

# Auth0
# AUTH0_DOMAIN: tenant domain used for management API and server-side Auth0 calls.
# AUTH0_PUBLIC_DOMAIN: public/custom domain exposed to the mobile app login flow.
AUTH0_DOMAIN=dev-zocy4q27tkkmjkmd.eu.auth0.com
AUTH0_PUBLIC_DOMAIN=cortege-auth.algernon.ovh
AUTH0_AUDIENCE=https://api.ibp-app
AUTH0_MGMT_CLIENT_ID=CHANGE_ME
AUTH0_MGMT_CLIENT_SECRET=CHANGE_ME
AUTH0_APP_CLIENT_ID=qaOBdPPo7eIMadCmIq5qDhmEGOqZF6py
# Optional timeout for Auth0 HTTP calls such as /userinfo (default shown)
# AUTH0_HTTP_TIMEOUT_MS=5000
