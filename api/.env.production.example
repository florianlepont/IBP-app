PORT=3000
NODE_ENV=production

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# S3-compatible object storage (OVH Object Storage)
OBJECT_STORAGE_MODE=minio
OBJECT_STORAGE_BUCKET=ibp-surveys
OBJECT_STORAGE_ENDPOINT=https://s3.<region>.perf.cloud.ovh.net
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME

# Cadastre IGN (production)
CADASTRE_PROVIDER=ign
CADASTRE_PROVIDER_ALLOW_FALLBACK=false
CADASTRE_PROVIDER_TIMEOUT_MS=2500
CADASTRE_IGN_REVERSE_URL=https://data.geopf.fr/geocodage/reverse
CADASTRE_IGN_APICARTO_PARCEL_URL=https://apicarto.ign.fr/api/cadastre/parcelle

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX
REFRESH_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Disable dev helpers (must stay false in production)
AUTH_DEV_EXPOSE_EMAIL_TOKEN=false
AUTH_LOGIN_OR_CREATE_ENABLED=false
DEBUG_DATA_RESET_ENABLED=false

# CORS — comma-separated list of allowed origins
# Example: https://api.ibp.example.com (no trailing slash)
CORS_ORIGIN=https://CHANGE_ME_YOUR_DOMAIN

# SMTP (Brevo / Sendinblue)
SMTP_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_BREVO_LOGIN
SMTP_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
SMTP_FROM=noreply@CHANGE_ME_YOUR_DOMAIN
EMAIL_CHANGE_CONFIRM_URL_TEMPLATE=https://CHANGE_ME_YOUR_DOMAIN/confirm-email?token={token}
