# E2E environment for `npm run test:e2e`. Copy to api/.env.test to customise
# (gitignored). POSTGRES_DB must end in _test: the E2E globalSetup drops and
# recreates its public schema on every run.
NODE_ENV=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibp_test
POSTGRES_USER=ibp
POSTGRES_PASSWORD=ibp
