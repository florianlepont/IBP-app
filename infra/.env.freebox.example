# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── MinIO (stockage photos) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_password
OBJECT_STORAGE_MODE=minio
OBJECT_STORAGE_BUCKET=ibp-media
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_strong_minio_password

# ── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_random_bytes_hex
REFRESH_TOKEN_SECRET=CHANGE_ME_64_random_bytes_hex
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://api.algernon.ovh

# ── Email (optionnel pour l'instant) ─────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org
EMAIL_CHANGE_CONFIRM_URL_TEMPLATE=

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=CHANGE_ME.eu.auth0.com
AUTH0_AUDIENCE=https://api.ibp-app
AUTH0_APP_CLIENT_ID=CHANGE_ME_AUTH0_APP_CLIENT_ID
AUTH0_MGMT_CLIENT_ID=CHANGE_ME_AUTH0_MGMT_CLIENT_ID
AUTH0_MGMT_CLIENT_SECRET=CHANGE_ME_AUTH0_MGMT_CLIENT_SECRET
AUTH_LOGIN_OR_CREATE_ENABLED=false
AUTH_DEV_EXPOSE_EMAIL_TOKEN=false
DEBUG_DATA_RESET_ENABLED=false
