# ── PostgreSQL ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Stockage objet / MinIO ───────────────────────────────────────────────────
OBJECT_STORAGE_MODE=minio
OBJECT_STORAGE_BUCKET=ibp-media
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_strong_minio_password

# ── MinIO container ──────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_password

# ── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_random_bytes_hex
REFRESH_TOKEN_SECRET=CHANGE_ME_64_random_bytes_hex
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Cadastre IGN ─────────────────────────────────────────────────────────────
CADASTRE_PROVIDER=ign
CADASTRE_PROVIDER_ALLOW_FALLBACK=true
CADASTRE_PROVIDER_TIMEOUT_MS=2500
CADASTRE_IGN_REVERSE_URL=https://data.geopf.fr/geocodage/reverse
CADASTRE_IGN_APICARTO_PARCEL_URL=https://apicarto.ign.fr/api/cadastre/parcelle

# ── Flags prod ───────────────────────────────────────────────────────────────
AUTH_DEV_EXPOSE_EMAIL_TOKEN=false
AUTH_LOGIN_OR_CREATE_ENABLED=false
DEBUG_DATA_RESET_ENABLED=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Laisse vide si seule l'app mobile native consomme l'API.
CORS_ORIGIN=

# ── Email (optionnel pour l'instant) ─────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_CHANGE_CONFIRM_URL_TEMPLATE=

# ── Auth0 ────────────────────────────────────────────────────────────────────
# Domaine tenant Auth0 reel, souvent xxx.eu.auth0.com
AUTH0_DOMAIN=CHANGE_ME_TENANT.eu.auth0.com
# Domaine public/custom utilise par l'app mobile
AUTH0_PUBLIC_DOMAIN=auth-ibp.algernon.ovh
AUTH0_AUDIENCE=https://api.ibp-app
AUTH0_APP_CLIENT_ID=qaOBdPPo7eIMadCmIq5qDhmEGOqZF6py
AUTH0_MGMT_CLIENT_ID=CHANGE_ME
AUTH0_MGMT_CLIENT_SECRET=CHANGE_ME
