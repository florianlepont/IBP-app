# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ibp
POSTGRES_USER=ibp
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── MinIO (stockage photos) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_password
MINIO_BUCKET=ibp-media

# ── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_random_bytes_hex
REFRESH_TOKEN_SECRET=CHANGE_ME_64_random_bytes_hex

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL publique de ton tunnel Cloudflare (ex: https://ibp-api.ton-domaine.com)
CORS_ORIGIN=https://CHANGE_ME.trycloudflare.com

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token obtenu sur https://one.dash.cloudflare.com → Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_tunnel_token_from_cloudflare_dashboard

# ── Email (optionnel pour l'instant) ─────────────────────────────────────────
# SMTP_HOST=smtp-etats-sauvages.alwaysdata.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=florian@etats-sauvages.org
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=florian@etats-sauvages.org

# ── Auth ─────────────────────────────────────────────────────────────────────
# Mettre false en prod (interdit la création auto de compte au login)
AUTH_LOGIN_OR_CREATE_ENABLED=false
