# Add these two blocks to the host Caddyfile (/etc/caddy/Caddyfile), next to
# the ones already serving other projects, then `sudo systemctl reload caddy`.
#
# Both names must resolve to this VPS before reloading, otherwise Caddy cannot
# obtain a certificate and will retry in a loop.

api.algernon.ovh {
	reverse_proxy 127.0.0.1:3000
}

# Object storage. Attachment URLs are presigned by the API, and the signature
# covers the Host header, so this name must match OBJECT_STORAGE_ENDPOINT
# exactly. Caddy forwards the original Host by default, which is what MinIO
# needs to validate the signature.
files.algernon.ovh {
	reverse_proxy 127.0.0.1:9000

	# Objects are large and clients are on mobile networks.
	request_body {
		max_size 50MB
	}
}
