[Unit]
Description=Update the Cortege stack from the registry
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=REPO_DIR=/home/ubuntu/cortege
Environment=ENV_FILE=/home/ubuntu/cortege.env
ExecStart=/home/ubuntu/cortege/infra/vps/update-stack.sh
