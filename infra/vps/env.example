# Runtime environment for the VPS stack.
#
# Copy to /home/ubuntu/cortege.env — outside the git clone, so a deployment
# never touches it — and `chmod 600`.

POSTGRES_DB=cortege
POSTGRES_USER=cortege
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

MINIO_ACCESS_KEY=cortege
MINIO_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD

OBJECT_STORAGE_BUCKET=cortege-media
OBJECT_STORAGE_REGION=us-east-1
# Public name served by the host Caddy. This exact value is signed into the
# attachment URLs the mobile app receives, so it must be what clients call —
# never an internal address such as http://minio:9000.
OBJECT_STORAGE_ENDPOINT=https://cortege-files.algernon.ovh

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX
REFRESH_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CADASTRE_PROVIDER=ign
CADASTRE_PROVIDER_ALLOW_FALLBACK=true
CADASTRE_PROVIDER_TIMEOUT_MS=2500
CADASTRE_IGN_REVERSE_URL=https://data.geopf.fr/geocodage/reverse
CADASTRE_IGN_APICARTO_PARCEL_URL=https://apicarto.ign.fr/api/cadastre/parcelle

# Must stay false in production.
AUTH_DEV_EXPOSE_EMAIL_TOKEN=false
AUTH_LOGIN_OR_CREATE_ENABLED=false
DEBUG_DATA_RESET_ENABLED=false

# none = aucune origine navigateur ; l'app mobile n'utilise pas CORS ;
# vide ou absent = démarrage refusé en production.
CORS_ORIGIN=none

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_CHANGE_CONFIRM_URL_TEMPLATE=

AUTH0_DOMAIN=dev-zocy4q27tkkmjkmd.eu.auth0.com
AUTH0_PUBLIC_DOMAIN=cortege-auth.algernon.ovh
AUTH0_AUDIENCE=https://api.ibp-app
AUTH0_APP_CLIENT_ID=qaOBdPPo7eIMadCmIq5qDhmEGOqZF6py
AUTH0_MGMT_CLIENT_ID=CHANGE_ME
AUTH0_MGMT_CLIENT_SECRET=CHANGE_ME

# Express trust proxy value; default loopback,uniquelocal. Caddy reaches the
# loopback-published API container through Docker's userland proxy, so the
# container sees the Docker bridge gateway (a private 172.x address), not
# 127.0.0.1, as the peer. Trusting it lets req.ip come from Caddy's
# X-Forwarded-For (per-client rate limits). Public peers are never trusted.
TRUST_PROXY=loopback,uniquelocal
