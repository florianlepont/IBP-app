{
  "extends": ["../.eslintrc.json", "plugin:react/recommended", "plugin:react-hooks/recommended"],
  "parserOptions": {
    "project": "./tsconfig.json",
    "tsconfigRootDir": "."
  },
  "plugins": ["react", "react-hooks"],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "@typescript-eslint/no-require-imports": "off"
  },
  "env": {
    "browser": false
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludedFiles": ["src/i18n/**", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "ImportSpecifier[imported.name='statusText']",
            "message": "Build status messages in src/i18n only (phase 01.9 D-06)"
          }
        ]
      }
    },
    {
      "files": [
        "src/screens/**/*.tsx",
        "src/components/**/*.tsx",
        "src/ui/**/*.tsx",
        "src/navigation/**/*.tsx"
      ],
      "excludedFiles": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name=/^(title|label|placeholder|accessibilityLabel|accessibilityHint|subtitle|message)$/] > Literal",
            "message": "Use the French catalogue in src/i18n (phase 01.9 D-06)"
          },
          {
            "selector": "JSXAttribute[name.name=/^(title|label|placeholder|accessibilityLabel|accessibilityHint|subtitle|message)$/] > JSXExpressionContainer > TemplateLiteral",
            "message": "Use the French catalogue in src/i18n (phase 01.9 D-06)"
          },
          {
            "selector": "CallExpression[callee.object.name='Alert'][callee.property.name='alert'] > :matches(Literal, TemplateLiteral)",
            "message": "Use the French catalogue in src/i18n (phase 01.9 D-06)"
          },
          {
            "selector": "ImportSpecifier[imported.name='statusText']",
            "message": "Build status messages in src/i18n only (phase 01.9 D-06)"
          }
        ]
      }
    },
    {
      "files": [
        "src/screens/SurveyDetailScreen*.tsx",
        "src/screens/survey-detail/**/*.tsx",
        "src/screens/SurveyFormScreen*.tsx",
        "src/screens/survey-form/**/*.tsx",
        "src/screens/PublicMapScreen*.tsx",
        "src/screens/public-map/**/*.tsx"
      ],
      "excludedFiles": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name=/^(title|label|placeholder|accessibilityLabel|accessibilityHint|subtitle|message)$/] > Literal",
            "message": "Use the French catalogue in src/i18n (phase 01.9 D-06)"
          },
          {
            "selector": "JSXAttribute[name.name=/^(title|label|placeholder|accessibilityLabel|accessibilityHint|subtitle|message)$/] > JSXExpressionContainer > TemplateLiteral",
            "message": "Use the French catalogue in src/i18n (phase 01.9 D-06)"
          },
          {
            "selector": "CallExpression[callee.object.name='Alert'][callee.property.name='alert'] > :matches(Literal, TemplateLiteral)",
            "message": "Use the French catalogue in src/i18n (phase 01.9 D-06)"
          },
          {
            "selector": "JSXOpeningElement[name.name='Pressable']:not(:has(JSXAttribute[name.name='accessibilityRole']))",
            "message": "Pressable needs accessibilityRole (phase 01.9 D-07)"
          },
          {
            "selector": "JSXOpeningElement[name.name='Pressable']:not(:has(JSXAttribute[name.name='accessibilityLabel']))",
            "message": "Pressable needs accessibilityLabel from the catalogue (phase 01.9 D-07)"
          },
          {
            "selector": "ImportSpecifier[imported.name='statusText']",
            "message": "Build status messages in src/i18n only (phase 01.9 D-06)"
          }
        ]
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "@typescript-eslint/no-require-imports": "off",
        "@typescript-eslint/no-var-requires": "off"
      }
    }
  ]
}
