{
  "expo": {
    "name": "Cortege",
    "slug": "cortege",
    "userInterfaceStyle": "light",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo-app.png",
    "platforms": ["ios", "android"],
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cortege to access your photos for survey attachments.",
          "cameraPermission": "Allow Cortege to use your camera to capture survey photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Cortege to access your location to center the map and help parcel selection."
        }
      ],
      "expo-secure-store",
      "react-native-bottom-tabs",
      [
        "react-native-auth0",
        {
          "domain": "cortege-auth.algernon.ovh"
        }
      ],
      "./plugins/with-scene-delegate"
    ],
    "ios": {
      "bundleIdentifier": "fr.etatssauvages.cortege",
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "fr.etatssauvages.cortege"
    }
  }
}
