{
  "expo": {
    "name": "IBP App",
    "slug": "ibp-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo-app.png",
    "platforms": ["ios", "android"],
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow IBP App to access your photos for survey attachments.",
          "cameraPermission": "Allow IBP App to use your camera to capture survey photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow IBP App to access your location to center the map and help parcel selection."
        }
      ],
      "expo-secure-store",
      "react-native-bottom-tabs",
      [
        "react-native-auth0",
        {
          "domain": "auth-ibp.algernon.ovh"
        }
      ]
    ],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fr.etats-sauvages.ibp-app"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "fr.etatssauvages.ibpapp"
    }
  }
}
