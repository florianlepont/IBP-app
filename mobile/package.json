{
  "name": "cortege-mobile",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "assets:herbier": "node scripts/remove-white-bg.mjs && python3 ../scripts/stamp-asset-copyright.py assets/herbier-transparent",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand --config jest.unit.config.js",
    "test:unit:coverage": "jest --runInBand --config jest.unit.config.js --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"App.tsx\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"App.tsx\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.19",
    "expo-location": "~57.0.19",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-auth0": "^5.4.0",
    "react-native-bottom-tabs": "^1.4.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jimp": "^1.6.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.1.0",
    "test-renderer": "^1.3.0",
    "ts-jest": "^29.4.6"
  }
