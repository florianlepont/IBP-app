{
  "name": "ibp-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "node scripts/patch-react-native-bottom-tabs.mjs",
    "assets:herbier": "node scripts/remove-white-bg.mjs && python3 ../scripts/stamp-asset-copyright.py assets/herbier-transparent",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand --config jest.unit.config.js",
    "test:unit:coverage": "jest --runInBand --config jest.unit.config.js --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"App.tsx\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"App.tsx\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.1.0",
    "@expo/ngrok": "^4.1.0",
    "@react-navigation/bottom-tabs": "^7.15.7",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-auth0": "^5.4.0",
    "react-native-bottom-tabs": "^1.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jimp": "^1.6.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6"
  }
}
